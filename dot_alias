shutdown() {
    trap 'echo "Cancelled."; exit 130' INT
    echo "Preparing shutdown in 5 seconds... Press Ctrl-C to cancel."
    sleep 5
    sudo shutdown now
}
reboot() {
    trap 'echo "Cancelled."; exit 130' INT
    echo "Preparing reboot in 5 seconds... Press Ctrl-C to cancel."
    sleep 5
    sudo shutdown --reboot now
}
