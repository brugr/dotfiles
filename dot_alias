# cd
### cd.. number
cd..() {
  if [[ -z "$1" ]]; then
    cd ..
  elif [[ "$1" =~ ^[0-9]+$ ]]; then
    cd $(printf "../%.0s" $(seq 1 "$1"))
  else
    echo "Usage: cd.. [number]"
    return 1
  fi
}
### Change directory & list files 
cl() {
   cd $1
   ls -lA --color=auto --human-readable --group-directories-first
}
# Make directory & enter it
mkcd() {
   mkdir -pv $1
   cd $1
}
